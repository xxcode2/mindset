# ─── Deployer ────────────────────────────────────────────────────────────────
# Private key of the deployer wallet (NEVER commit the real one).
# Use a fresh wallet, fund it from a Base Sepolia faucet for testnet.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ─── RPC endpoints ──────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# ─── Contract parameters ────────────────────────────────────────────────────

# Address that receives the 5% protocol fee from losing pools + slashed resolver bonds.
# Immutable after deploy. Use a dedicated treasury wallet (not your daily driver).
FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# Owner address: can approve/reject proposals, manage trusted resolvers, adjust bond,
# and pause/unpause the contract. Use a Safe multisig for production.
# If not set, defaults to the deployer address.
OWNER_ADDRESS=

# Bond (in token base units) that a non-trusted resolver must lock when proposing an outcome.
# Slashed on rejection, refunded on approval/timeout. Default: 10 USDC (10 * 10^6).
# Can be adjusted post-deploy by the owner up to 100 USDC max.
RESOLVER_BOND=10000000

# Creation fee (in token base units) charged when creating a market (anti-spam).
# Default: 5 USDC (5 * 10^6). Immutable after deploy.
CREATION_FEE=5000000

# Optional: existing ERC20 token address to use as the betting token (e.g. USDC on Base mainnet).
# If empty, the deploy script will deploy a MockUSDC alongside (good for testnet).
# Base mainnet USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BETTING_TOKEN=

# ─── Verification ───────────────────────────────────────────────────────────
# Optional, for contract verification on BaseScan
BASESCAN_API_KEY=
