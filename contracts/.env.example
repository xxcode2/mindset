# Private key of the deployer wallet (NEVER commit the real one)
# Use a fresh wallet for testnet, fund it with Base Sepolia ETH from the faucet.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC endpoints (defaults are public, ok for testing)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Address that receives forfeited stakes. Cannot be changed after deploy.
# For real charity, e.g. Giveth / GiveDirectly Base address.
# For testnet, you can use any address you do not control.
CHARITY_ADDRESS=0x0000000000000000000000000000000000000000

# Optional, for contract verification on BaseScan
BASESCAN_API_KEY=
