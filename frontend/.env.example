# Address of the deployed PredictionMarket contract on Base Sepolia
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Address of the deployed ChainlinkPriceResolver (auto-resolves price markets)
NEXT_PUBLIC_PRICE_RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000

# Address of the betting ERC20 token (MockUSDC on testnet, USDC on mainnet)
NEXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TOKEN_SYMBOL=MUSDC
NEXT_PUBLIC_TOKEN_DECIMALS=6

# 84532 = Base Sepolia (testnet), 8453 = Base mainnet
NEXT_PUBLIC_CHAIN_ID=84532

# RPC endpoints (optional, falls back to public endpoints if empty).
# For mainnet production, use a dedicated provider (Alchemy, Infura, QuickNode, etc.)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# WalletConnect Cloud Project ID (free): https://cloud.walletconnect.com
# Required for the standalone (non-Farcaster) website wallet flow.
NEXT_PUBLIC_WC_PROJECT_ID=

# Public URL of your deployed app, used by Farcaster manifest + share embeds.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Farcaster webhook signature secret (server-side only).
# When set, the webhook endpoint verifies HMAC-SHA256 signatures.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
